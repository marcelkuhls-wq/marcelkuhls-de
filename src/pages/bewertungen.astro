---
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { testimonials, reportages } from '../data/reportages';
// Alle Zitate exakt wie auf marcelkuhls.de veröffentlicht. Erika & Roland aus der Reportage.
const extra = reportages.filter((r) => r.quote && !testimonials.some((t) => t.by === r.quote!.by)).map((r) => ({ by: r.quote!.by, where: r.place ?? 'Hochzeit', text: r.quote!.text, img: r.side }));
const all = [...testimonials, ...extra];
---
<Base title="Bewertungen: Erfahrungen mit Hochzeitsfotograf Marcel Kuhls" description="5,0 von 5 Sternen bei 18 Google-Bewertungen. Was Paare über ihre Hochzeitsreportage mit Marcel Kuhls in Hamburg sagen.">
  <PageHero crumbs={[{ label: 'Bewertungen' }]}>
    <h1 slot="title"><span class="h1-kw" data-fade="0.2">Bewertungen &amp; Erfahrungen</span> <span data-split data-split-now>Was Paare <em>sagen</em></span></h1>
    <div slot="aside" data-fade="0.4" class="rv-score"><span class="rv-stars" aria-hidden="true">★★★★★</span><p><strong>5,0 von 5</strong><br />bei 18 Bewertungen auf Google</p><p><a class="link" href={site.google} rel="noopener" target="_blank">Alle Bewertungen auf Google</a></p></div>
  </PageHero>
  <section class="wrap" style="padding-bottom: var(--space)">
    <div class="rv-list">
      {all.map((t, i) => (
        <figure class="rv" data-fade={String((i % 3) * 0.06)}>
          <Photo src={t.img} alt={t.by} ratio="4/3" sizes="(max-width: 899px) 100vw, 33vw" />
          <blockquote>„{t.text}“</blockquote>
          <figcaption><strong>{t.by}</strong> · {t.where}</figcaption>
        </figure>
      ))}
    </div>
    <p style="margin-top:56px;text-align:center"><a class="btn btn--solid" href="/kontakt/">Verfügbarkeit anfragen <span class="arr">→</span></a></p>
  </section>
</Base>
<style>
  .rv-score { display: grid; gap: 6px; }
  .rv-score p { margin: 0; }
  .rv-stars { color: #e7b04a; font-size: 1.4rem; letter-spacing: 3px; }
  .rv-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(32px, 4vw, 56px) var(--gap); }
  .rv { margin: 0; display: grid; gap: 16px; align-content: start; }
  .rv blockquote { margin: 0; font-family: var(--f-display); font-size: 1.3rem; line-height: 1.3; font-style: italic; font-weight: 320; }
  .rv figcaption { font-size: var(--fs-small); color: var(--ink-2); }
  @media (max-width: 899px) { .rv-list { grid-template-columns: 1fr; } }
</style>
