---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
---
<Base title="Seite nicht gefunden | Marcel Kuhls" description="Diese Seite gibt es nicht mehr." noindex>
  <section class="wrap phero" style="padding-bottom: var(--space)">
    <div class="g" style="align-items:center">
      <div style="grid-column: 1 / 7"><h1 data-split data-split-now>Hier ist <em>niemand.</em></h1><p class="lead" style="margin:24px 0 32px">Die Seite gibt es nicht mehr. Die Hochzeiten schon.</p><a class="btn btn--solid" href="/portfolio/">Zu den Reportagen <span class="arr">→</span></a></div>
      <div style="grid-column: 8 / 12"><Photo src="sb-joana-dennis/090" alt="" ratio="3/2" /></div>
    </div>
  </section>
</Base>
