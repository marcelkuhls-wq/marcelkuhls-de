---
// Text 1:1 von marcelkuhls.de/hochzeit-gutshaus-norddeutschland/ übernommen (Stand 20.10.2026), neues Layout und neue Fotos.
import Base from '../layouts/Base.astro';
import LegacyArticle from '../components/LegacyArticle.astro';
import { series } from '../data/photos';
import { articleSchema } from '../data/article';
import html from '../data/legacy/hochzeit-gutshaus-norddeutschland.html?raw';

const j = series('joana-dennis-gut-bardenhagen'), m = series('mariana-mirco-hochzeit-haus-schnede'), p = series('michelle-benjamin');
const hero = j[15];
const photos = [m[10], p[5], j[35], m[30], p[25], j[50]];
---
<Base title="Hochzeit im Gutshaus bei Hamburg: Licht, Ablauf & Fotos" description="Hochzeit im Gutshaus oder Herrenhaus rund um Hamburg? Ein Hochzeitsfotograf erklärt, worauf ihr bei Location, Licht und Zeitplan achten solltet." ogImage={hero} schema={articleSchema('/hochzeit-gutshaus-norddeutschland/', 'Hochzeit im Gutshaus: Locations, Licht und Foto-Tipps'.trim(), 'Gutshaus-Hochzeit')}>
  <LegacyArticle html={html} title="Hochzeit im Gutshaus:" titleEm="Locations, Licht und Foto-Tipps" eyebrow="Ratgeber · Locations" crumb="Gutshaus-Hochzeit" hero={hero} photos={photos}>
    <p style="margin-top:2.4em"><a class="btn btn--solid" href="/kontakt/">Verfügbarkeit anfragen <span class="arr">→</span></a></p>
  </LegacyArticle>
</Base>
